    frame.Size = UDim2.new(1, -20, 0, 35)
    frame.Position = UDim2.new(0, 10, 0, posY)
    frame.BackgroundTransparency = 1
    frame.Parent = MainFrame

    local btn = Instance.new("TextButton")
    btn.Size = defaultInputText and UDim2.new(0, 140, 1, 0) or UDim2.new(1, 0, 1, 0)
    btn.Position = UDim2.new(0, 0, 0, 0)
    btn.BackgroundColor3 = Color3.fromRGB(55, 58, 68)
    btn.Text = btnText
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.Parent = frame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    local box = nil
    if defaultInputText then
        box = Instance.new("TextBox")
        box.Size = UDim2.new(0, 75, 1, 0)
        box.Position = UDim2.new(1, -75, 0, 0)
        box.BackgroundColor3 = Color3.fromRGB(20, 22, 26)
        box.Text = defaultInputText
        box.TextColor3 = Color3.fromRGB(255, 255, 255)
        box.TextSize = 13
        box.Font = Enum.Font.GothamBold
        box.Parent = frame

        local boxCorner = Instance.new("UICorner")
        boxCorner.CornerRadius = UDim.new(0, 6)
        boxCorner.Parent = box
    end

    return btn, box
end

